# Server
APP_NAME=Birga Arzon API
APP_ENV=development
HTTP_HOST=0.0.0.0
HTTP_PORT=8080

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=birga
DB_PASSWORD=birga_secret
DB_NAME=birga_arzon
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2

# Migrations (safe by default: never auto-drop data)
MIGRATE_DIR=migrations
MIGRATE_LOCK_TIMEOUT=15s

# Auth
JWT_SECRET=birga-arzon-dev-secret-change-me
JWT_EXPIRES_HOURS=72

# Eskiz.uz SMS (mijoz OTP)
ESKIZ_EMAIL=
ESKIZ_PASSWORD=
ESKIZ_FROM=4546
OTP_TTL_MINUTES=5
OTP_RESEND_SECONDS=60

# Atmos payment (invoice checkout)
ATMOS_CONSUMER_KEY=
ATMOS_CONSUMER_SECRET=
ATMOS_STORE_ID=
ATMOS_API_KEY=
ATMOS_BASE_URL=https://apigw.atmos.uz
ATMOS_CHECKOUT_URL=https://checkout.atmos.uz
FRONTEND_URL=https://birgaarzon.uz
